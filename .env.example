# Copia este fichero a .env.local y rellena los valores de tu proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Emails admin separados por comas (alternativa/complemento a la tabla public.admins).
ADMIN_EMAILS=admin@example.com
# Opcional: sobrescribe la versión mostrada en la cabecera (por defecto, src/lib/version.ts).
NEXT_PUBLIC_APP_VERSION=
